{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/scripts", "demo", "e2e", "scripts", "playwright.config.ts"]
}
