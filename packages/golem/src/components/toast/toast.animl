<!-- Tone glyphs on Onyx's 16-unit icon grid, 1.25-unit strokes. Core-only trim draw,
     fired once after ready. DOM data-tone selects the glyph; static full paths mount at rest. -->
<anima version="0.1" name="golem-toast" grid="16" viewBox="0 0 16 16">
  <color name="infoFg" value="#66a0c8"/><color name="successFg" value="#879a39"/>
  <color name="dangerFg" value="#e8705f"/><color name="warningFg" value="#d0a215"/>
  <bool name="success" default="false"/><bool name="danger" default="false"/><bool name="warning" default="false"/>
  <trigger name="draw"/>
  <ease name="emph" curve="cubic(0.2, 0, 0.16, 1)"/>
  <group id="info" opacity="1">
    <path id="info-ring" d="M8 1.75A6.25 6.25 0 1 1 8 14.25A6.25 6.25 0 1 1 8 1.75Z" stroke="infoFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    <path id="info-mark" d="M8 7V11M8 4.75V4.8" stroke="infoFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
  </group>
  <group id="success" opacity="0">
    <path id="success-ring" d="M8 1.75A6.25 6.25 0 1 1 8 14.25A6.25 6.25 0 1 1 8 1.75Z" stroke="successFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    <path id="success-mark" d="M4.75 8L7 10.25L11.25 5.75" stroke="successFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
  </group>
  <group id="danger" opacity="0">
    <path id="danger-ring" d="M8 1.75A6.25 6.25 0 1 1 8 14.25A6.25 6.25 0 1 1 8 1.75Z" stroke="dangerFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    <path id="danger-mark" d="M5.75 5.75L10.25 10.25M10.25 5.75L5.75 10.25" stroke="dangerFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
  </group>
  <group id="warning" opacity="0">
    <path id="warning-ring" d="M8 1.75L14.25 13H1.75Z" stroke="warningFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    <path id="warning-mark" d="M8 6V9M8 11V11.05" stroke="warningFg" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
  </group>
  <layer name="tone" initial="info">
    <state name="info"><pose info.opacity="1" success.opacity="0" danger.opacity="0" warning.opacity="0"/><on when="success" to="success"/><on when="danger" to="danger"/><on when="warning" to="warning"/></state>
    <state name="success"><pose info.opacity="0" success.opacity="1" danger.opacity="0" warning.opacity="0"/><on when="!success and !danger and !warning" to="info"/><on when="danger" to="danger"/><on when="warning" to="warning"/></state>
    <state name="danger"><pose info.opacity="0" success.opacity="0" danger.opacity="1" warning.opacity="0"/><on when="!success and !danger and !warning" to="info"/><on when="success" to="success"/><on when="warning" to="warning"/></state>
    <state name="warning"><pose info.opacity="0" success.opacity="0" danger.opacity="0" warning.opacity="1"/><on when="!success and !danger and !warning" to="info"/><on when="success" to="success"/><on when="danger" to="danger"/></state>
  </layer>
  <timeline name="draw-in" duration="0.2" reducedMotion="end">
    <track target="info-ring.trimEnd">0 0 emph; 0.2 1</track>
    <track target="info-mark.trimEnd">0 0 emph; 0.2 1</track>
    <track target="success-ring.trimEnd">0 0 emph; 0.2 1</track>
    <track target="success-mark.trimEnd">0 0 emph; 0.2 1</track>
    <track target="danger-ring.trimEnd">0 0 emph; 0.2 1</track>
    <track target="danger-mark.trimEnd">0 0 emph; 0.2 1</track>
    <track target="warning-ring.trimEnd">0 0 emph; 0.2 1</track>
    <track target="warning-mark.trimEnd">0 0 emph; 0.2 1</track>
  </timeline>
  <layer name="entrance" initial="rest">
    <state name="rest"><on when="draw" to="drawing"/></state>
    <state name="drawing" play="draw-in"><on when="@end" to="rest"/></state>
  </layer>
</anima>
