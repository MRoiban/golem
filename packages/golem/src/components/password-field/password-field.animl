<!-- Golem PasswordField eye: Onyx's Codicon `eye` / `eye-closed` glyphs (16-unit grid, 1 px strokes),
     redrawn as strokes on the 1em glyph box so the drawing at rest matches Onyx's icon.
     Closed means revealed, matching Onyx's eye-closed glyph and Hide password action.
     Motion: on each change the eye blinks (lid and pupil squash about the eye's centre) while the
     slash draws in or out. The slash is a rotated horizontal stroke scaled along its own X axis,
     which avoids the trim/dash end-cap artifact (findings F9). Core only. -->
<anima version="0.1" name="golem-password-field" grid="16" viewBox="0 0 16 16">
  <color name="fg" value="#cecdc3"/>
  <bool name="closed" default="false"/>
  <group id="eye" pivot="8 8.67">
    <path id="lid" d="M2.02 8.83Q8 -0.49 13.98 8.83" stroke="fg" stroke-width="1"/>
    <circle id="pupil" cx="8" cy="8.67" r="2.17" stroke="fg" stroke-width="1" pivot="8 8.67"/>
  </group>
  <group id="slashAxis" x="1.83" y="1.83" rotate="45">
    <path id="slash" d="M0 0L17.45 0" stroke="fg" stroke-width="1" scaleX="0" opacity="0"/>
  </group>
  <ease name="std" curve="cubic(0.2, 0, 0, 1)"/>
  <ease name="emph" curve="cubic(0.2, 0, 0.16, 1)"/>
  <layer name="visibility" initial="open">
    <state name="open"><on when="closed" to="closed" blend="0.16" ease="std"/></state>
    <state name="closed">
      <pose slash.scaleX="1" slash.opacity="1"/>
      <on when="!closed" to="open" blend="0.16" ease="std"/>
    </state>
  </layer>
  <timeline name="blink" duration="0.2" reducedMotion="end">
    <track target="eye.scaleY">0 1 emph; 0.08 0.25 emph; 0.2 1</track>
    <track target="pupil.scale">0 1 emph; 0.08 0.7 emph; 0.2 1</track>
  </timeline>
  <!-- Edge detection: entering c or o2 plays the blink; the initial state o does not (rest on mount). -->
  <layer name="fx" initial="o">
    <state name="o"><on when="closed" to="c"/></state>
    <state name="c" play="blink"><on when="!closed" to="o2"/></state>
    <state name="o2" play="blink"><on when="closed" to="c"/></state>
  </layer>
</anima>
