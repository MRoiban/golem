<!-- Onyx size=sm eye, a 12-unit drawing scaled to its 1em font glyph. Closed means revealed, matching
     Onyx's eye-closed glyph and Hide password action. Lid flattens, pupil fades, slash draws.
     Core only: the lid flattens about its centre; a rotated horizontal stroke grows along
     its own X axis to draw the slash without the trim/dash end-cap artifact (findings F9). -->
<anima version="0.1" name="golem-password-field" grid="12" viewBox="0 0 12 12">
  <color name="fg" value="#cecdc3"/>
  <bool name="closed" default="false"/>
  <path id="lid" pivot="6 6" d="M1 6C3 2 9 2 11 6C9 10 3 10 1 6" stroke="fg" stroke-width="0.9"/>
  <circle id="pupil" cx="6" cy="6" r="1.6" fill="fg" pivot="6 6"/>
  <group id="slashAxis" x="1.5" y="1.5" rotate="45">
    <path id="slash" d="M0 0L12.728 0" stroke="fg" stroke-width="1" scaleX="0" opacity="0"/>
  </group>
  <ease name="std" curve="cubic(0.2, 0, 0, 1)"/>
  <layer name="visibility" initial="open">
    <state name="open"><on when="closed" to="closed" blend="0.16" ease="std"/></state>
    <state name="closed">
      <pose lid.scaleY="0.16" pupil.scale="0" pupil.opacity="0" slash.scaleX="1" slash.opacity="1"/>
      <on when="!closed" to="open" blend="0.16" ease="std"/>
    </state>
  </layer>
</anima>
